# All values are optional. Environment variables override .env.
SMARTSITE_AI_ENVIRONMENT=development
SMARTSITE_AI_HOST=127.0.0.1
SMARTSITE_AI_PORT=8000
SMARTSITE_AI_LOG_LEVEL=info

# Backend AI observation event ingestion (optional, no default active secret)
# SMARTSITE_AI_BACKEND_INGESTION_URL=http://localhost:3000
# SMARTSITE_AI_BACKEND_SERVICE_TOKEN=

# Backend -> AI identity enrollment endpoint. Use the same service token as
# SMARTSITE_AI_SERVICE_TOKEN in the backend for local integration.
# SMARTSITE_AI_IDENTITY_SERVICE_TOKEN=

# Optional academic/non-commercial face-recognition demo. Startup never downloads
# the model. Install it explicitly with smartsite-ai-install-demo-model, then use
# an absolute private volume path and an externally managed Fernet key.
# SMARTSITE_AI_IDENTITY_DEMO_MODE=true
# SMARTSITE_AI_IDENTITY_MODEL_ROOT=/var/lib/smartsite-ai/model-root
# SMARTSITE_AI_IDENTITY_TEMPLATE_STORE_PATH=/var/lib/smartsite-ai/templates/face-templates.fernet
# SMARTSITE_AI_IDENTITY_TEMPLATE_ENCRYPTION_KEY=
# SMARTSITE_AI_IDENTITY_MATCH_THRESHOLD=0.45

# Prefer this server-side secret for credentialed RTSP URLs instead of a CLI argument.
# SMARTSITE_AI_WORKER_SOURCE=rtsp://user:password@camera.example/stream

# Realtime inference is opt-in. `auto` uses the first CUDA GPU only when the
# installed PyTorch runtime reports one; otherwise it uses CPU.
SMARTSITE_AI_REALTIME_DEVICE=auto

# Never commit real model paths, camera credentials, or external API keys.
